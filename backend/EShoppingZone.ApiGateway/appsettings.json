          "Path": "/api/wallet/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/wallet/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://profile-service.bluetree-541edc58.centralindia.azurecontainerapps.io/"
