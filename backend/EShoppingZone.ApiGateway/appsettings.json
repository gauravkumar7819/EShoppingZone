{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "eshoppingzone-super-secret-jwt-key-256-bits-long",
    "Issuer": "EShoppingZone",
    "Audience": "EShoppingZoneUsers"
  },
  "ReverseProxy": {
    "Routes": {
      "profile-service": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/profile/{**catch-all}" }
        ]
      },
      "auth-service": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "admin-analytics-service": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/admin/analytics/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/analytics/{**catch-all}" }
        ]
      },
      "admin-order-service": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/admin/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/orders/{**catch-all}" }
        ]
      },
      "admin-profile-service": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/{**catch-all}" }
        ]
      },
      "product-service": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/product/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/product/{**catch-all}" }
        ]
      },
      "merchant-product-service": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/merchant-products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/merchant-products/{**catch-all}" }
        ]
      },
      "admin-product-service": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/admin/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/products/{**catch-all}" }
        ]
      },
      "cart-service": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/cart/{**catch-all}" }
        ]
      },
      "order-service": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/order/{**catch-all}" }
        ]
      },
      "wallet-service": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/wallet/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://profile-service/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://product-service/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-service/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-service/"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://wallet-service/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}